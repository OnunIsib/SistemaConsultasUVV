@model SistemaConsultasUVV.Models.Consulta

@{
    ViewData["Title"] = "Excluir Consulta";
}

<div class="container mt-4">

    <h2>Excluir Consulta</h2>

    <div class="alert alert-danger">
        <strong>Atenção!</strong>
        Tem certeza que deseja excluir esta consulta?
    </div>

    <dl class="row">

        <dt class="col-sm-3">
            Especialidade
        </dt>

        <dd class="col-sm-9">
            @Model.Especialidade
        </dd>

        <dt class="col-sm-3">
            Data/Hora
        </dt>

        <dd class="col-sm-9">
            @Model.DataHora.ToString("dd/MM/yyyy HH:mm")
        </dd>

        <dt class="col-sm-3">
            Descrição
        </dt>

        <dd class="col-sm-9">
            @Model.Descricao
        </dd>

    </dl>

    <form asp-action="Delete"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="Id" />

        <button type="submit"
                class="btn btn-danger">
            Confirmar Exclusão
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>