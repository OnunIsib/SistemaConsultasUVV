@model IEnumerable<SistemaConsultasUVV.Models.Consulta>

@{
    ViewData["Title"] = "Minhas Consultas";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center">
        <h2>Minhas Consultas</h2>

        <a asp-action="Create"
           class="btn btn-success">
            + Nova Consulta
        </a>
    </div>

    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Você ainda não possui consultas cadastradas.
        </div>
    }
    else
    {
        <table class="table table-striped">

            <thead>
                <tr>
                    <th>Especialidade</th>
                    <th>Data/Hora</th>
                    <th>Descrição</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var consulta in Model)
                {
                    <tr>
                        <td>
                            @consulta.Especialidade
                        </td>

                        <td>
                            @consulta.DataHora.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @consulta.Descricao
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@consulta.Id"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@consulta.Id"
                               class="btn btn-danger btn-sm">
                                Excluir
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>
    }

    <form asp-controller="Account"
          asp-action="Logout"
          method="post">

        <button type="submit"
                class="btn btn-secondary">
            Sair
        </button>

    </form>

</div>
